rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: validate UUID v4 format
    function isValidUUID(id) {
      return id.matches('^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$');
    }

    // Sessions collection
    match /sessions/{sessionId} {
      allow read: if isValidUUID(sessionId);
      allow create: if isValidUUID(sessionId)
                    && request.resource.data.sessionId == sessionId;
      allow update: if isValidUUID(sessionId)
                    && request.resource.data.sessionId == sessionId;
      allow delete: if false;
    }

    // Chats collection — write only via Cloud Functions
    match /chats/{sessionId} {
      allow read: if isValidUUID(sessionId);
      allow write: if false; // Only Cloud Functions can write
    }

    // Elections collection — read only
    match /elections/{doc} {
      allow read: if true;
      allow write: if false;
    }
  }
}
